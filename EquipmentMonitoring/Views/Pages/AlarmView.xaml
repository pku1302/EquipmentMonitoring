<UserControl x:Class="EquipmentMonitoring.Views.Pages.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EquipmentMonitoring.Views.Pages"
             mc:Ignorable="d" >
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                Text="Active Alarms"
                FontSize="24"
                FontWeight="Bold"/>

            <TextBlock
                Margin="0,6,0,16"
                Text="{Binding ActiveAlarms.Count, StringFormat=Active Count: {0}}"/>
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{Binding ActiveAlarms}">

            <ListView.View>
                <GridView>

                    <GridViewColumn
                        Header="Equipment"
                        Width="100"
                        DisplayMemberBinding="{Binding EquipmentId}"/>

                    <GridViewColumn
                        Header="Code"
                        Width="140"
                        DisplayMemberBinding="{Binding AlarmCode}"/>

                    <GridViewColumn
                        Header="Severity"
                        Width="100"
                        DisplayMemberBinding="{Binding Severity}"/>

                    <GridViewColumn
                        Header="Message"
                        Width="300"
                        DisplayMemberBinding="{Binding AlarmMessage}"/>

                    <GridViewColumn
                        Header="Occurred At"
                        Width="160"
                        DisplayMemberBinding="{Binding OccurredAt}"/>

                </GridView>
            </ListView.View>

        </ListView>

        <StackPanel 
            Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,0,0,10">

            <TextBox
                Width="100"
                Margin="0,0,10,0"
                Text="{Binding SelectedEquipmentId}"
                ToolTip="Equipment ID"/>

             <DatePicker
                SelectedDate="{Binding From}"
                Margin="0,0,10,0"/>

                    <DatePicker
                SelectedDate="{Binding To}"
                Margin="0,0,10,0"/>

                    <Button
                Content="Search"
                Command="{Binding SearchHistoryCommand}"/>
        </StackPanel>
        <ListView 
            Grid.Row="3"
            ItemsSource="{Binding AlarmHistory}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                Header="Equipment"
                Width="100"
                DisplayMemberBinding="{Binding EquipmentId}"/>

                    <GridViewColumn
                Header="Code"
                Width="120"
                DisplayMemberBinding="{Binding AlarmCode}"/>

                    <GridViewColumn
                Header="Severity"
                Width="100"
                DisplayMemberBinding="{Binding Severity}"/>

                    <GridViewColumn
                Header="Message"
                Width="300"
                DisplayMemberBinding="{Binding AlarmMessage}"/>

                    <GridViewColumn
                Header="Occurred"
                Width="150"
                DisplayMemberBinding="{Binding OccurredAt}"/>

                    <GridViewColumn
                Header="Cleared"
                Width="150"
                DisplayMemberBinding="{Binding ClearedAt}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
