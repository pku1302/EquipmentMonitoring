<UserControl x:Class="EquipmentMonitoring.Views.Pages.LiveChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:chart="clr-namespace:EquipmentMonitoring.Views.Chart"
             xmlns:components="clr-namespace:EquipmentMonitoring.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid
        Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단: 설비 선택 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Equipment Overview"
                    FontSize="22"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Real-time equipment status"
                    FontSize="13"
                    Foreground="#6B7280"
                    Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <TextBlock
                    Text="LIVE 일시정지"
                    Foreground="#B91C1C"
                    FontWeight="SemiBold"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger
                                Binding="{Binding IsAutoFollow}"
                                Value="False">
                                    <Setter
                            Property="Visibility"
                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

                <!-- 시간 범위 버튼 -->
                <Button
                    Content="24시간"
                    Width="56"
                    Height="32"
                    Margin="0,0,6,0"
                    Command="{Binding SetChartRangeCommand}"
                    CommandParameter="24H"/>

                <Button
                    Content="12시간"
                    Width="56"
                    Height="32"
                    Margin="0,0,6,0"
                    Command="{Binding SetChartRangeCommand}"
                    CommandParameter="12H"/>

                <Button
                    Content="1시간"
                    Width="56"
                    Height="32"
                    Margin="0,0,6,0"
                    Command="{Binding SetChartRangeCommand}"
                    CommandParameter="1H"/>

                <Button
                    Content="LIVE"
                    Width="64"
                    Height="32"
                    Margin="0,0,18,0"
                    Command="{Binding LiveCommand}"/>

                <TextBlock
                    Text="Equipment"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"/>

                <ComboBox
                    Width="220"
                    ItemsSource="{Binding Equipments}"
                    SelectedItem="{Binding SelectedEquipment}"
                    DisplayMemberPath="Name"/>
            </StackPanel>
        </Grid>

        <!-- 하단: KPI 카드 -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <components:KPICardView
            Grid.Column="0"
            DataContext="{Binding ProductionCountCard}"
            Margin="0,0,8,0"/>

            <components:KPICardView
            Grid.Column="1"
            DataContext="{Binding ProductionRateCard}"
            Margin="0,0,8,0"/>

            <components:KPICardView
            Grid.Column="2"
            DataContext="{Binding MotorRpmCard}"
            Margin="0,0,8,0"/>

            <components:KPICardView
            Grid.Column="3"
            DataContext="{Binding AlarmCountCard}"/>

        </Grid>

        <!-- ================================= -->
        <!-- Charts -->
        <!-- ================================= -->

        <chart:SensorChartView 
            Margin="0,8,0,0"
            Grid.Row="2"
            DataContext="{Binding TemperatureChart}"
            RangeChanged="SensorChart_RangeChanged"/>

        <chart:SensorChartView 
            Grid.Row="3"
            DataContext="{Binding PressureChart}"
            RangeChanged="SensorChart_RangeChanged"/>

        <chart:SensorChartView 
            Grid.Row="4"
            DataContext="{Binding MotorRpmChart}"
            RangeChanged="SensorChart_RangeChanged"/>
    </Grid>
</UserControl>
