<Window x:Class="EquipmentMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentMonitoring"
        xmlns:vm="clr-namespace:EquipmentMonitoring.ViewModels"
        xmlns:views="clr-namespace:EquipmentMonitoring.Views"
        mc:Ignorable="d"
        Title="Equipment Monitoring" 
        Height="900" 
        Width="1400">
    <Window.Resources>
        
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
            <views:EquipmentView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AlarmViewModel}">
            <views:AlarmView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    <StackPanel
        Grid.Column="0"
        Background="#252525">
        
        <TextBlock
            Text="MONITORING"
            Foreground="White"
            FontSize="22"
            FontWeight="Bold"
            Margin="20,30"/>
        
        <Button 
            Content="Dashboard"
            Command="{Binding ShowDashboardCommand}"
            Height="50"
            Margin="10,5"/>
        
        <Button 
            Content="Equipment"
            Command="{Binding ShowEquipmentCommand}"
            Height="50"
            Margin="10,5"/>
        
        <Button 
            Content="Alarm"
            Command="{Binding ShowAlarmCommand}"
            Height="50"
            Margin="10,5"/>
        
        <Button 
            Content="Log"
            Command="{Binding ShowLogCommand}"
            Height="50"
            Margin="10,5"/>
        
    </StackPanel>
    
    <ContentControl
        Grid.Column="1"
        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
