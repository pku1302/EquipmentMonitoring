    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EquipmentMonitoring.Core\EquipmentMonitoring.Core.csproj" />
  </ItemGroup>

</Project>
